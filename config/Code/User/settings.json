{
  // -----------------------------------------
  // G E N E R A L
  // -----------------------------------------

  // Trust
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.enabled": false,

  // Terminal Settings
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "\"MesloLGS NF\", monospace",
  "terminal.integrated.fontSize": 15,

  // Editor
  "editor.fontFamily": "\"Fira Code\", Consolas, 'Courier New', monospace",
  "editor.fontSize": 18,
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,

  // Prettier
  "editor.formatOnSave": true,
  "prettier.singleQuote": true,
  "prettier.semi": false,

  // Workbench
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.browser.openLocalhostLinks": false,
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Nord",
  "workbench.preferredLightColorTheme": "Dark Modern",
  "workbench.preferredDarkColorTheme": "Breeze Dark",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.editorAssociations": {
    "*.svg": "default",
  },

  // Window
  "window.titleBarStyle": "custom",
  "window.autoDetectColorScheme": true,

  // Git
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.autofetch": true,

  // Explorer
  "explorer.confirmDelete": false,

  // Extenssion
  "MinifyAll.PrefixOfNewMinifiedFiles": ".min",

  // -----------------------------------------
  // L A N G s
  // -----------------------------------------

  "[javascript][javascriptreact][typescript][typescriptreact][css][scss][html][json][jsonc][markdown][mdx][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
  },

  "[xml]": {
    "editor.defaultFormatter": "DotJoshJohnson.xml",
  },

  "[php]": {
    "editor.defaultFormatter": "kokororin.vscode-phpfmt",
  },

  "js/ts.updateImportsOnFileMove.enabled": "always",

  // -----------------------------------------
  // A I  &  C H A T
  // -----------------------------------------
  "chat.disableAIFeatures": true,

  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
  },

  "editor.aiStats.enabled": false,
  "workbench.editor.enablePreview": false,
}
